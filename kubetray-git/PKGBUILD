pkgname=kubetray-git
_pkgname=kubetray
pkgver=r5.8ecf218
pkgrel=1
pkgdesc="Tray app to switch the current Kubernetes context"
arch=('x86_64')
url="https://github.com/ericklv/kubetray"
license=('AGPL-3.0-only')
depends=('dbus')
optdepends=('kubectl: switch contexts (any kubectl in PATH works)'
            'google-cloud-cli: GKE sessions and kubetray-sync-gke')
makedepends=('git' 'go')
options=('!debug')
provides=("$_pkgname")
conflicts=("$_pkgname")
source=("git+$url.git")
sha256sums=('SKIP')

pkgver() {
  cd "$_pkgname"
  printf "r%s.%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
}

build() {
  cd "$_pkgname"
  export GOFLAGS="-buildmode=pie -trimpath -mod=readonly -modcacherw"
  go build -o "$_pkgname" .
}

package() {
  cd "$_pkgname"
  install -Dm755 "$_pkgname" "$pkgdir/usr/bin/$_pkgname"
  install -Dm755 sync-gke.sh "$pkgdir/usr/bin/kubetray-sync-gke"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
