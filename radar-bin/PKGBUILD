pkgname=radar-bin
pkgver=1.18.3
pkgrel=1
pkgdesc="Kubernetes visibility desktop app — topology, traffic, and Helm management"
arch=('x86_64')
url="https://github.com/skyhook-io/radar"
license=('Apache-2.0')
depends=('gtk3' 'webkit2gtk-4.1')
provides=('radar-desktop')
conflicts=('radar-desktop')
options=('!strip' '!debug')
source=("https://github.com/skyhook-io/radar/releases/download/v$pkgver/radar-desktop_v${pkgver}_linux_amd64.deb")
sha256sums=('ce9d26c84f4054cc40db6e32e03cdb45a1560ecd1b8eb1fc0370c53e131ed244')

package() {
  bsdtar -xf data.tar.gz -C "$pkgdir"
  chmod -R go-w "$pkgdir"
}
